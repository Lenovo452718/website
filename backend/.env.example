# Copy this file to .env and fill in your values

# Port the server runs on
PORT=3000

# Secret key to protect your API from outside requests
# Change this to any random string you want
API_SECRET=my-secret-key-change-this

# Your store's WhatsApp number (the one you scan QR with)
# Format: international without + (e.g. 212771152186)
STORE_PHONE=212771152186

# Store name shown in messages
STORE_NAME=StreetStore

# URL of your website (for CORS)
WEBSITE_URL=https://yourusername.github.io
